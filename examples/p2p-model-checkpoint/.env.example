# Copy to .env (or export manually) and adjust as needed.
# None of these are required to run the demo with default local settings.

# Kubo (go-ipfs) HTTP RPC API base URL. Defaults to a local daemon.
IPFS_API_URL=http://127.0.0.1:5001/api/v0

# Enable verbose libp2p debug logging (see py-libp2p docs). Optional.
# LIBP2P_DEBUG=DEBUG

# Bind address overrides (rarely needed for the local demo).
# LIBP2P_BIND=0.0.0.0
# LIBP2P_BIND_V6=::
