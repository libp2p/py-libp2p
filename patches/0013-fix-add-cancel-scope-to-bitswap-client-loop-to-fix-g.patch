From 9dba9423b9d2cba603ec35a18d433b5b59ff25ea Mon Sep 17 00:00:00 2001
From: sumanjeet0012 <sumanjeet0012@gmail.com>
Date: Sat, 25 Jul 2026 14:29:51 +0530
Subject: [PATCH 13/13] fix: add cancel scope to bitswap client loop to fix
 graceful shutdown

---
 libp2p/bitswap/client.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/libp2p/bitswap/client.py b/libp2p/bitswap/client.py
index e30c61f3..30e47c47 100644
--- a/libp2p/bitswap/client.py
+++ b/libp2p/bitswap/client.py
@@ -105,6 +105,7 @@ class BitswapClient:

         self._nursery: trio.Nursery | None = None
         self._started = False
+        self._cancel_scope: trio.CancelScope | None = None

     def register_extension(self, protocol: str, extension: "IBitswapExtension") -> None:
         """Register an extension for a specific protocol."""
@@ -126,15 +127,17 @@ class BitswapClient:
             )

         self._started = True
+        self._cancel_scope = trio.CancelScope()
         if self._nursery is not None:
             self._nursery.start_soon(self._presence_cleanup_loop)
         logger.info(f"Bitswap client started (protocol: {self.protocol_version})")

     async def _presence_cleanup_loop(self) -> None:
         """Periodic background task to clean up expired presence state."""
-        while self._started:
-            await trio.sleep(10)
-            self.presence_manager.cleanup_expired()
+        with self._cancel_scope:
+            while self._started:
+                await trio.sleep(10)
+                self.presence_manager.cleanup_expired()

     async def stop(self) -> None:
         """Stop the Bitswap client."""
@@ -142,6 +145,8 @@ class BitswapClient:
             return

         self._started = False
+        if self._cancel_scope is not None:
+            self._cancel_scope.cancel()
         # Unregister stream handlers for all supported Bitswap protocols
         for protocol in self.supported_protocols:
             self.host.remove_stream_handler(TProtocol(protocol))
